# Database — local SQLite for dev, Turso for production
DATABASE_URL="file:./prisma/dev.db"
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# Auth
NEXTAUTH_URL="http://localhost:3006"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AI Providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
XAI_API_KEY=""

# Image Generation — allow DALL-E fallback when Imagen unavailable
ALLOW_PAID_IMAGE_FALLBACK="true"

# Object Storage (Cloudflare R2 or AWS S3)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
